@model IsTakipSistemiMvc.Models.Personel

@{
    ViewBag.Title = "Personel Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger shadow">
            <div class="card-header bg-danger text-white text-center">
                <h3><i class="fas fa-user-times"></i> Silme Onayı</h3>
            </div>
            <div class="card-body text-center">
                <h5 class="card-title text-danger mb-4">Bu personeli silmek istediğinize emin misiniz?</h5>

                <div class="alert alert-light border">
                    <p><strong>Ad Soyad:</strong> @Html.DisplayFor(model => model.AdSoyad)</p>
                    <p><strong>Departman:</strong> @(Model.Birim != null ? Model.Birim.BirimAd : "-")</p>
                    <p><strong>Yetki:</strong> @(Model.YetkiTur != null ? Model.YetkiTur.YetkiAd : "-")</p>
                </div>

                <div class="alert alert-warning">
                    <small><i class="fas fa-exclamation-triangle"></i> Dikkat: Bu işlem geri alınamaz.</small>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-secondary me-2">
                            <i class="fas fa-times"></i> Vazgeç
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash-alt"></i> Evet, Sil
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>