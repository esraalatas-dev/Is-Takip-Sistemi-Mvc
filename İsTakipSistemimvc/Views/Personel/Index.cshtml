@model IEnumerable<IsTakipSistemiMvc.Models.Personel>

@{
    ViewBag.Title = "Personel Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- ÜST KISIM: Başlık ve Ekle Butonu -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users"></i> Personel Listesi</h2>

    <!-- İŞTE BURASI: Yeni Personel Ekle Butonu -->
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
        <i class="fas fa-user-plus"></i> Yeni Personel Ekle
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>Telefon</th>
                    <th>Departman</th>
                    <th>Yetki</th>
                    <th style="width: 200px;" class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">
                            <i class="fas fa-user-circle text-muted me-2"></i>@Html.DisplayFor(modelItem => item.AdSoyad)
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.KullaniciAd)</td>
                        <td>@Html.DisplayFor(modelItem => item.Telefon)</td>
                        <td>
                            @if (item.Birim != null)
                            {
                                <span class="badge bg-secondary">@item.Birim.BirimAd</span>
                            }
                        </td>
                        <td>
                            @if (item.YetkiTur != null)
                            {
                                if (item.YetkiTur.YetkiAd == "Yönetici")
                                {
                                    <span class="badge bg-danger">Yönetici</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Çalışan</span>
                                }
                            }
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("Edit", new { id=item.PersonelId })" class="btn btn-sm btn-warning text-dark" title="Düzenle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Details", new { id=item.PersonelId })" class="btn btn-sm btn-info text-white" title="Detay">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a href="@Url.Action("Delete", new { id=item.PersonelId })" class="btn btn-sm btn-danger" title="Sil">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>