@model IsTakipSistemiMvc.Models.Personel

@{
    ViewBag.Title = "Personel Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-warning">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="fas fa-user-edit"></i> Personeli Düzenle</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.PersonelId)

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ad Soyad</label>
                            @Html.EditorFor(model => model.AdSoyad, new { htmlAttributes = new { @class = "form-control" } })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Kullanıcı Adı</label>
                                @Html.EditorFor(model => model.KullaniciAd, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Parola</label>
                                @Html.EditorFor(model => model.Parola, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Telefon</label>
                            @Html.EditorFor(model => model.Telefon, new { htmlAttributes = new { @class = "form-control" } })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Departman</label>
                                @Html.DropDownList("BirimId", null, htmlAttributes: new { @class = "form-select" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Yetki Türü</label>
                                @Html.DropDownList("YetkiTurId", null, htmlAttributes: new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a href="@Url.Action("Index")" class="btn btn-secondary me-2">
                                <i class="fas fa-arrow-left"></i> İptal
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-sync-alt"></i> Güncelle
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>