@model IEnumerable<IsTakipSistemiMvc.Models.YetkiTur>

@{
    ViewBag.Title = "Yetki Türleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Üst Başlık ve Yeni Ekle Butonu -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-lock"></i> Yetki Türleri</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus"></i> Yeni Yetki Ekle
    </a>
</div>

<!-- Tablo Alanı -->
<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <!-- HOCANIN İSTEDİĞİ ID: myTable -->
            <table id="myTable" class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Yetki Adı</th>
                        <th class="text-end" style="width: 250px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <i class="fas fa-key text-muted me-2"></i>@Html.DisplayFor(modelItem => item.YetkiAd)
                            </td>
                            <td class="text-end">
                                <!-- Güncelle Butonu -->
                                <a href="@Url.Action("Edit", new { id=item.YetkiTurId })" class="btn btn-sm btn-warning" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <!-- Detay Butonu (Eksik Olan Buydu) -->
                                <a href="@Url.Action("Details", new { id=item.YetkiTurId })" class="btn btn-sm btn-info text-white" title="Detay">
                                    <i class="fas fa-info-circle"></i>
                                </a>

                                <!-- Sil Butonu -->
                                <a href="@Url.Action("Delete", new { id=item.YetkiTurId })" class="btn btn-sm btn-danger" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- HOCANIN PDF'İNDEKİ SCRIPT -->
<!-- DataTables'ı Türkçe Olarak Çalıştırır -->
<script type="text/javascript">
    var $j = jQuery.noConflict(true);

    $j(document).ready(function () {
        $j('#myTable').DataTable({
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/Turkish.json"
            }
        });
    });
</script>