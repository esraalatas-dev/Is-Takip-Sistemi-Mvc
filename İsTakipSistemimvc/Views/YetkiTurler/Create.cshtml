@model IsTakipSistemiMvc.Models.YetkiTur

@{
    ViewBag.Title = "Yeni Yetki Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-user-shield"></i> Yeni Yetki Oluştur</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="mb-4">
                            <label class="form-label fw-bold">Yetki Adı</label>
                            @Html.EditorFor(model => model.YetkiAd, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: Editör" } })
                            @Html.ValidationMessageFor(model => model.YetkiAd, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Index")" class="btn btn-secondary me-2">
                                <i class="fas fa-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Kaydet
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>