@model IEnumerable<IsTakipSistemiMvc.Models.Birim>

@{
    ViewBag.Title = "Departmanlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-building"></i> Departman Listesi</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus"></i> Yeni Departman Ekle
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Departman Adı</th>
                            <th style="width: 200px;" class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold ps-4 text-primary">
                                    <i class="far fa-building text-muted me-2"></i>@Html.DisplayFor(modelItem => item.BirimAd)
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Edit", new { id=item.BirimId })" class="btn btn-sm btn-outline-warning" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id=item.BirimId })" class="btn btn-sm btn-outline-info" title="Detay">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id=item.BirimId })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Yan Bilgi Kutusu -->
    <div class="col-md-4">
        <div class="alert alert-info border-0 shadow-sm">
            <h5><i class="fas fa-info-circle"></i> Bilgi</h5>
            <p>Departmanlar, personellerin çalıştığı birimleri temsil eder. Bir departmanı silmeden önce içinde personel olmadığından emin olunuz.</p>
        </div>
    </div>
</div>