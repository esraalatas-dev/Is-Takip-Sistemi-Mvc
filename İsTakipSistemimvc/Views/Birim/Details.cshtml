@model IsTakipSistemiMvc.Models.Birim

@{
    ViewBag.Title = "Departman Detayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="fas fa-info-circle"></i> Departman Detayı</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Departman Adı</dt>
                    <dd class="col-sm-8 fw-bold fs-5">@Html.DisplayFor(model => model.BirimAd)</dd>

                    <dt class="col-sm-4 text-muted mt-3">Personel Sayısı</dt>
                    <dd class="col-sm-8 mt-3">
                        <span class="badge bg-secondary">
                            <!-- Eğer personel listesi boşsa 0 yazsın, yoksa sayısını yazsın -->
                            @(Model.Personeller != null ? Model.Personeller.Count : 0) Personel
                        </span>
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white">
                <a href="@Url.Action("Edit", new { id = Model.BirimId })" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Düzenle
                </a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2">
                    Listeye Dön
                </a>
            </div>
        </div>
    </div>
</div>