@{
    ViewBag.Title = "Admin Ana Sayfa";
}

<h2 class="mb-4"><i class="fas fa-tachometer-alt"></i> İş Durum Özeti</h2>

<div class="row">
    <!-- Mavi Kart: Toplam İş -->
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3 shadow">
            <div class="card-header">Toplam İş</div>
            <div class="card-body">
                <h1 class="card-title">@ViewBag.ToplamIs</h1>
                <p class="card-text">Sistemdeki toplam görev sayısı.</p>
            </div>
        </div>
    </div>

    <!-- Yeşil Kart: Biten İşler -->
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3 shadow">
            <div class="card-header">Tamamlanan</div>
            <div class="card-body">
                <h1 class="card-title">@ViewBag.TamamlananIs</h1>
                <p class="card-text">Bitirilmiş görev sayısı.</p>
            </div>
        </div>
    </div>

    <!-- Sarı Kart: Devam Edenler -->
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3 shadow">
            <div class="card-header text-dark">Devam Eden</div>
            <div class="card-body text-dark">
                <h1 class="card-title">@ViewBag.DevamEdenIs</h1>
                <p class="card-text">Şu an üzerinde çalışılanlar.</p>
            </div>
        </div>
    </div>

    <!-- Kırmızı Kart: Personel Sayısı -->
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3 shadow">
            <div class="card-header">Personel Sayısı</div>
            <div class="card-body">
                <h1 class="card-title">@ViewBag.ToplamPersonel</h1>
                <p class="card-text">Kayıtlı toplam çalışan.</p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4">
    <i class="fas fa-info-circle"></i>
    Sol menüden işlem yapmak istediğiniz tabloyu seçebilirsiniz.
</div>