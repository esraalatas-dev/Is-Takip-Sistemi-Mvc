<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Paneli - İş Takip</title>

    <!-- 1. Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- 2. İkonlar (FontAwesome) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- 3. DataTables CSS (Akıllı Tablolar için) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>
        body {
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
            background-color: #f4f6f9;
        }

        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background: #2c3e50;
            color: #fff;
            transition: all 0.3s;
        }

        .sidebar-header {
            padding: 20px;
            background: #1a252f;
            text-align: center;
        }

        .sidebar ul.components {
            padding: 20px 0;
            list-style: none;
            padding-left: 0;
        }

        .sidebar ul li a {
            padding: 15px 20px;
            font-size: 1.1em;
            display: block;
            color: #ecf0f1;
            text-decoration: none;
            border-left: 4px solid transparent;
        }

            .sidebar ul li a:hover {
                background: #34495e;
                border-left-color: #3498db;
            }

            .sidebar ul li a i {
                margin-right: 10px;
                width: 20px;
                text-align: center;
            }

        .content {
            width: 100%;
            padding: 20px;
        }

        .navbar {
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <!-- SOL MENÜ -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3><i class="fas fa-tasks"></i> İş Takip</h3>
        </div>

        <ul class="components">
            <li><a href="@Url.Action("Index", "Dashboard")"><i class="fas fa-tachometer-alt"></i> Panel Özeti</a></li>

            <!--

            -->
            <li><a href="@Url.Action("Index", "Isler")"><i class="fas fa-list"></i> İş Listesi</a></li>
            <li><a href="@Url.Action("Index", "Personel")"><i class="fas fa-users"></i> Personeller</a></li>
            <li><a href="@Url.Action("Index", "Birim")"><i class="fas fa-building"></i> Departmanlar</a></li>
            <li><a href="@Url.Action("Index", "Durumlar")"><i class="fas fa-spinner"></i> Durumlar</a></li>
            <li><a href="@Url.Action("Index", "YetkiTurler")"><i class="fas fa-user-lock"></i> Yetki Türleri</a></li>
            <li style="margin-top: 50px; border-top: 1px solid #485f75;"><a href="@Url.Action("Index", "Home")" target="_blank"><i class="fas fa-globe"></i> Siteye Git</a></li>
            <li>
                <a href="/Login/LogOut" class="text-danger"><i class="fas fa-sign-out-alt"></i> Çıkış Yap</a>
            </li>
        </ul>
    </nav>

    <!-- İÇERİK ALANI -->
    <div class="content">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid">
                <span class="navbar-text"><b>Hoşgeldiniz,</b> Yönetici</span>
            </div>
        </nav>

        <div class="container-fluid bg-white p-4 rounded shadow-sm">
            @RenderBody()
        </div>

        <footer class="mt-4 text-center text-muted">
            <small>&copy; 2024 İş Takip Sistemi - Tüm Hakları Saklıdır.</small>
        </footer>
    </div>

    <!-- Scriptler  ckeditor için -->
    <!-- 1. Önce jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- 2. Sonra Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 3. Sonra DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- 4. Sonra CKEditor manuel -->
    <script src="~/Content/ckeditor/ckeditor.js"></script>


    <!-- 5. Tabloları Çalıştıran ve CKEditor Uyarısını önleme: -->
    <script>
        $(document).ready(function () {
            // DataTables Başlatma
            $('.table').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"   /*türkçe dil dosyası*/
                }
            });    /* bu kod projedeki tüm tabloları otomatik olarak akıllı tabloya çeviriyor*/

            // CKEditor "Sürüm Güvenli Değil" Uyarısını Kapatmak için:
            if (typeof CKEDITOR !== 'undefined') {
                CKEDITOR.config.versionCheck = false;
            }
        });
    </script>

    <!-- 6. Sayfalara Özel Script Alanı -->
    @RenderSection("scripts", required: false)
</body>
</html>