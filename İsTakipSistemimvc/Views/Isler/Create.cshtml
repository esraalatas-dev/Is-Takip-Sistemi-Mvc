@model IsTakipSistemiMvc.Models.Is

@{
    ViewBag.Title = "Yeni İş Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-plus-circle"></i> Yeni İş Oluştur</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="mb-3">
                            <label class="form-label fw-bold">İş Başlığı</label>
                            @Html.EditorFor(model => model.Baslik, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: Stok Sayımı" } })
                            @Html.ValidationMessageFor(model => model.Baslik, "", new { @class = "text-danger" })
                        </div>

                        <!-- CKEDITOR (PDF'e Uygun ID ve Yapı) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Açıklama</label>
                            @Html.TextAreaFor(model => model.Aciklama, new { @class = "form-control", @rows = "4", @id = "editor" })
                            @Html.ValidationMessageFor(model => model.Aciklama, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Teslim Tarihi</label>
                                @Html.EditorFor(model => model.Tarih, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                                @Html.ValidationMessageFor(model => model.Tarih, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Sorumlu Personel</label>
                                @Html.DropDownList("PersonelId", null, htmlAttributes: new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.PersonelId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Durum</label>
                            @Html.DropDownList("DurumId", null, htmlAttributes: new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.DurumId, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Index")" class="btn btn-secondary me-2">
                                <i class="fas fa-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Kaydet
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- HOCANIN İSTEDİĞİ JS YAPISI -->
@section scripts {
    <!-- CKEditor kütüphanesini garanti olsun diye buraya da ekliyoruz -->
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Hata almamak için kontrol ediyoruz
            if (typeof CKEDITOR !== 'undefined') {
                CKEDITOR.replace('editor');  /* bu kod 'Açıklama' kutusunu yakalayıp editöre dönüştürüyor*/
            } else {
                console.error("CKEditor yüklenemedi!");
            }
        });
    </script>
}