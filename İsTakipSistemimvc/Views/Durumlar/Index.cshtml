@model IEnumerable<IsTakipSistemiMvc.Models.Durum>

@{
    ViewBag.Title = "Durumlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-spinner"></i> İş Durumları</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus"></i> Yeni Durum Ekle
    </a>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Durum Adı</th>
                            <th style="width: 200px;" class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (item.DurumAd == "Yapıldı")
                                    {
                                        <span class="badge bg-success fs-6">@item.DurumAd</span>
                                    }
                                    else if (item.DurumAd == "Yapılıyor")
                                    {
                                        <span class="badge bg-warning text-dark fs-6">@item.DurumAd</span>
                                    }
                                    else if (item.DurumAd == "Ertelendi")
                                    {
                                        <span class="badge bg-danger fs-6">@item.DurumAd</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary fs-6">@item.DurumAd</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Edit", new { id=item.DurumId })" class="btn btn-sm btn-outline-warning" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id=item.DurumId })" class="btn btn-sm btn-outline-info" title="Detay">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id=item.DurumId })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="alert alert-info border-0 shadow-sm">
            <h5><i class="fas fa-info-circle"></i> Bilgi</h5>
            <p>Buradaki durumlar, işlerin ilerleme sürecini takip etmek için kullanılır. İstatistikler bu durumlara göre hesaplanır.</p>
        </div>
    </div>
</div>